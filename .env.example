# 복사해서 .env로 사용. 실제 값은 시크릿 매니저에서 주입하고 절대 커밋하지 않는다.
APP_ENV=development
LOG_LEVEL=INFO
# 쉼표로 구분된 허용 오리진 (와일드카드 금지)
CORS_ORIGINS=http://localhost:3000

POSTGRES_DB=resume
POSTGRES_USER=resume_app
POSTGRES_PASSWORD=change-me-long-random

REDIS_PASSWORD=change-me-long-random

NEXT_PUBLIC_API_URL=http://localhost:8000
