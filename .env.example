# 복사해서 .env로 사용. 실제 값은 시크릿 매니저에서 주입하고 절대 커밋하지 않는다.
APP_ENV=development
LOG_LEVEL=INFO
# 브라우저가 접속하는 웹 오리진(쉼표 구분, 와일드카드 금지). 상태 변경 요청의 Origin 검사에 사용.
WEB_ORIGINS=http://localhost:3000

# Postgres 슈퍼유저 — migrate 서비스에만 전달된다. 앱은 resume_app(DML 전용, RLS 적용)으로 접속.
POSTGRES_ADMIN_USER=pg_admin
POSTGRES_ADMIN_PASSWORD=change-me-long-random
POSTGRES_DB=resume
APP_DB_PASSWORD=change-me-long-random

# 필드 암호화 키 (32바이트 base64). 생성: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# ponytail: 개발용 로컬 KMS 모의. 운영은 클라우드 KMS 사용 (OPEN_QUESTIONS #4)
# 로테이션: 새 버전 추가 → KEK_CURRENT 변경 → `python -m app.cli rotate-kek` → 이전 키 제거
KEK_KEYS=1:REPLACE_WITH_BASE64_32_BYTES
KEK_CURRENT=1
# 블라인드 인덱스 전용 키 (KEK와 반드시 다른 값)
BIDX_KEY=REPLACE_WITH_BASE64_32_BYTES

# 유출 비밀번호 검사(HIBP). 오프라인 개발에서만 false.
HIBP_ENABLED=true
